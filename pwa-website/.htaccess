RewriteEngine On

# Build-stamped files (?v=build-<sha>, see tools/stamp_version.py) never change: a new build is a new
# URL. Marked here so the headers below can say so. Without it they went out as "re-check every time",
# and Cloudflare, which already held a copy, asked Bluehost about each one on every request
# (cf-cache-status: REVALIDATED) -- 0.3 to 4.7 seconds each on 2026-09-23, dozens per first visit.
RewriteCond %{QUERY_STRING} (^|&)v=build-[0-9a-f]+(&|$)
RewriteRule \.(js|css|svg|png|ico)$ - [E=FORTRESS_STAMPED:1]

# The app owns three URL shapes, and only these are handed to it:
#
#   /quran/<surah>/<ayah>      a verse
#   /hisn/chapter<n>           a dua
#   /<collection>/book<b>/<n>  a hadith
#
# Anything else that is not a real file now 404s instead of being answered with the app shell.
# A catch-all rewrite returns 200 and a page for every URL ever guessed at, which is a soft 404:
# a crawler is told a page exists, indexes a shell with no content, and does it again for every
# variation it invents. Saying "no" is what stops that.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^quran/[0-9]{1,3}/[0-9]{1,3}/?$ index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^hisn/chapter[0-9]{1,4}/?$ index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^[a-z0-9-]+/book[^/]+/[^/]+/?$ index.html [L]

# The root itself, and nothing beyond it.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^$ index.html [L]

# Development files must never be served from the public origin. Excluding them from the deploy
# stops new uploads but cannot remove copies already on disk: once a path is excluded the FTP action
# no longer tracks it, so it is orphaned rather than deleted. 0.24.0 shipped package.json,
# vitest.config.js and test/ this way. Denying them here is what actually takes them off the web,
# and it keeps covering any stray file of these kinds in future.
<FilesMatch "^(package(-lock)?\.json|vitest\.config\.js|serve\.py|.*\.test\.js)$">
  Require all denied
</FilesMatch>

RedirectMatch 404 ^/(test|tools|node_modules)(/|$)

# The host's server-level mod_expires was applying "max-age=14400" to /js/*.js and winning over the
# Header set below, so a fresh index.html + fresh app.js got paired with hours-stale modules after a
# deploy. Module imports are now build-stamped (tools/stamp_version.py), which fixes that on its own,
# but ExpiresActive is switched off for these types too so the header we send is the header served.
<IfModule mod_expires.c>
  <FilesMatch "\.(?:html|js|css|json|webmanifest)$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|js|css|json|webmanifest)$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always unset Expires
    Header always unset Pragma
  </FilesMatch>

  <Files "sw.js">
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </Files>

  <FilesMatch "\.(?:png|webp|svg)$">
    Header always set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Last, so it wins over the blocks above: a stamped file may be kept for a year by the browser and
  # by Cloudflare's edge. Unset in both header tables first -- the host's own mod_expires writes one
  # and this file the other, which is how app.js went out as "max-age=14400, must-revalidate".
  <FilesMatch "\.(?:js|css|svg|png|ico)$">
    Header unset Cache-Control env=FORTRESS_STAMPED
    Header unset Expires env=FORTRESS_STAMPED
    Header always set Cache-Control "public, max-age=31536000, immutable" env=FORTRESS_STAMPED
  </FilesMatch>
</IfModule>
