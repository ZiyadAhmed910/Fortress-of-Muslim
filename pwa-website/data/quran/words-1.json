{"number":1,"ayahs":[[["بِسْمِ","In (the) name"],["ٱللَّهِ","(of) Allah"],["ٱلرَّحْمَـٰنِ","the Most Gracious"],["ٱلرَّحِيمِ","the Most Merciful"]],[["ٱلْحَمْدُ","All praises and thanks"],["لِلَّهِ","(be) to Allah"],["رَبِّ","the Lord"],["ٱلْعَـٰلَمِينَ","of the universe"]],[["ٱلرَّحْمَـٰنِ","The Most Gracious"],["ٱلرَّحِيمِ","the Most Merciful"]],[["مَـٰلِكِ","(The) Master"],["يَوْمِ","(of the) Day"],["ٱلدِّينِ","(of the) Judgment"]],[["إِيَّاكَ","You Alone"],["نَعْبُدُ","we worship"],["وَإِيَّاكَ","and You Alone"],["نَسْتَعِينُ","we ask for help"]],[["ٱهْدِنَا","Guide us"],["ٱلصِّرَٰطَ","(to) the path"],["ٱلْمُسْتَقِيمَ","the straight"]],[["صِرَٰطَ","(The) path"],["ٱلَّذِينَ","(of) those"],["أَنْعَمْتَ","You have bestowed (Your) Favors"],["عَلَيْهِمْ","on them"],["غَيْرِ","not (of)"],["ٱلْمَغْضُوبِ","those who earned (Your) wrath"],["عَلَيْهِمْ","on themselves"],["وَلَا","and not"],["ٱلضَّآلِّينَ","(of) those who go astray"]]]}