{"number":114,"nameArabic":"الناس","nameSimple":"An-Nas","nameEnglish":"Mankind","revelationPlace":"makkah","ayahCount":6,"bismillahPre":true,"ayahs":[{"n":1,"ar":"قُل أَعوذُ بِرَبِّ النّاسِ","tj":"قُلْ أَعُوذُ بِرَبِّ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_permissible>َا</tajweed>سِ <span class=end>١</span>","en":"Say, \"I seek refuge in the Lord of mankind,"},{"n":2,"ar":"مَلِكِ النّاسِ","tj":"مَلِكِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_permissible>َا</tajweed>سِ <span class=end>٢</span>","en":"The Sovereign of mankind."},{"n":3,"ar":"إِلٰهِ النّاسِ","tj":"إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_permissible>َا</tajweed>سِ <span class=end>٣</span>","en":"The God of mankind,"},{"n":4,"ar":"مِن شَرِّ الوَسواسِ الخَنّاسِ","tj":"مِ<tajweed class=ikhafa>ن ش</tajweed>َرِّ <tajweed class=ham_wasl>ٱ</tajweed>لْوَسْوَاسِ <tajweed class=ham_wasl>ٱ</tajweed>لْخَ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_permissible>َا</tajweed>سِ <span class=end>٤</span>","en":"From the evil of the retreating whisperer -"},{"n":5,"ar":"الَّذى يُوَسوِسُ فى صُدورِ النّاسِ","tj":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_permissible>َا</tajweed>سِ <span class=end>٥</span>","en":"Who whispers [evil] into the breasts of mankind -"},{"n":6,"ar":"مِنَ الجِنَّةِ وَالنّاسِ","tj":"مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْجِ<tajweed class=ghunnah>نّ</tajweed>َةِ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_permissible>َا</tajweed>سِ <span class=end>٦</span>","en":"From among the jinn and mankind.\""}]}