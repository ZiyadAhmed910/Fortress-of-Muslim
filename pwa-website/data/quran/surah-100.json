{"number":100,"nameArabic":"العاديات","nameSimple":"Al-'Adiyat","nameEnglish":"The Courser","revelationPlace":"makkah","ayahCount":11,"bismillahPre":true,"ayahs":[{"n":1,"ar":"وَالعٰدِيٰتِ ضَبحًا","tj":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>دِيَ<tajweed class=madda_normal>ـٰ</tajweed>تِ ضَ<tajweed class=qalaqah>بْ</tajweed>حًا <span class=end>١</span>","en":"By the racers, panting,"},{"n":2,"ar":"فَالمورِيٰتِ قَدحًا","tj":"فَ<tajweed class=ham_wasl>ٱ</tajweed>لْمُورِيَ<tajweed class=madda_normal>ـٰ</tajweed>تِ قَ<tajweed class=qalaqah>دْ</tajweed>حًا <span class=end>٢</span>","en":"And the producers of sparks [when] striking"},{"n":3,"ar":"فَالمُغيرٰتِ صُبحًا","tj":"فَ<tajweed class=ham_wasl>ٱ</tajweed>لْمُغِير<tajweed class=madda_normal>َٲ</tajweed>تِ صُ<tajweed class=qalaqah>بْ</tajweed>حًا <span class=end>٣</span>","en":"And the chargers at dawn,"},{"n":4,"ar":"فَأَثَرنَ بِهِ نَقعًا","tj":"فَأَثَرْنَ بِه<tajweed class=madda_normal>ِۦ</tajweed> نَ<tajweed class=qalaqah>قْ</tajweed>عًا <span class=end>٤</span>","en":"Stirring up thereby [clouds of] dust,"},{"n":5,"ar":"فَوَسَطنَ بِهِ جَمعًا","tj":"فَوَسَ<tajweed class=qalaqah>طْ</tajweed>نَ بِه<tajweed class=madda_normal>ِۦ</tajweed> جَمْعًا <span class=end>٥</span>","en":"Arriving thereby in the center collectively,"},{"n":6,"ar":"إِنَّ الإِنسٰنَ لِرَبِّهِ لَكَنودٌ","tj":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ لِرَبِّه<tajweed class=madda_normal>ِۦ</tajweed> لَكَن<tajweed class=madda_permissible>ُو</tajweed><tajweed class=qalaqah>د</tajweed>ٌ <span class=end>٦</span>","en":"Indeed mankind, to his Lord, is ungrateful."},{"n":7,"ar":"وَإِنَّهُ عَلىٰ ذٰلِكَ لَشَهيدٌ","tj":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> عَلَىٰ ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ لَشَه<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٌ <span class=end>٧</span>","en":"And indeed, he is to that a witness."},{"n":8,"ar":"وَإِنَّهُ لِحُبِّ الخَيرِ لَشَديدٌ","tj":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لِحُبِّ <tajweed class=ham_wasl>ٱ</tajweed>لْخَيْرِ لَشَد<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٌ <span class=end>٨</span>","en":"And indeed he is, in love of wealth, intense."},{"n":9,"ar":"أَفَلا يَعلَمُ إِذا بُعثِرَ ما فِى القُبورِ","tj":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى <tajweed class=ham_wasl>ٱ</tajweed>لْقُب<tajweed class=madda_permissible>ُو</tajweed>رِ <span class=end>٩</span>","en":"But does he not know that when the contents of the graves are scattered"},{"n":10,"ar":"وَحُصِّلَ ما فِى الصُّدورِ","tj":"وَحُصِّلَ مَا فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صُّد<tajweed class=madda_permissible>ُو</tajweed>رِ <span class=end>١٠</span>","en":"And that within the breasts is obtained,"},{"n":11,"ar":"إِنَّ رَبَّهُم بِهِم يَومَئِذٍ لَخَبيرٌ","tj":"إِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِهِمْ يَوْمَئِ<tajweed class=idgham_wo_ghunnah>ذٍ ل</tajweed>َّخَب<tajweed class=madda_permissible>ِي</tajweed>رُۢ <span class=end>١١</span>","en":"Indeed, their Lord with them, that Day, is [fully] Acquainted."}]}