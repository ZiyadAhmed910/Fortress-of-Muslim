{"number":101,"nameArabic":"القارعة","nameSimple":"Al-Qari'ah","nameEnglish":"The Calamity","revelationPlace":"makkah","ayahCount":11,"bismillahPre":true,"ayahs":[{"n":1,"ar":"القارِعَةُ","tj":"ٱلْقَارِعَةُ <span class=end>١</span>","en":"The Striking Calamity -"},{"n":2,"ar":"مَا القارِعَةُ","tj":"مَا <tajweed class=ham_wasl>ٱ</tajweed>لْقَارِعَةُ <span class=end>٢</span>","en":"What is the Striking Calamity?"},{"n":3,"ar":"وَما أَدرىٰكَ مَا القارِعَةُ","tj":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=qalaqah>دْ</tajweed>رَ<tajweed class=madda_normal>ٮٰ</tajweed>كَ مَا <tajweed class=ham_wasl>ٱ</tajweed>لْقَارِعَةُ <span class=end>٣</span>","en":"And what can make you know what is the Striking Calamity?"},{"n":4,"ar":"يَومَ يَكونُ النّاسُ كَالفَراشِ المَبثوثِ","tj":"يَوْمَ يَكُونُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسُ كَ<tajweed class=ham_wasl>ٱ</tajweed>لْفَرَاشِ <tajweed class=ham_wasl>ٱ</tajweed>لْمَ<tajweed class=qalaqah>بْ</tajweed>ث<tajweed class=madda_permissible>ُو</tajweed>ثِ <span class=end>٤</span>","en":"It is the Day when people will be like moths, dispersed,"},{"n":5,"ar":"وَتَكونُ الجِبالُ كَالعِهنِ المَنفوشِ","tj":"وَتَكُونُ <tajweed class=ham_wasl>ٱ</tajweed>لْجِبَالُ كَ<tajweed class=ham_wasl>ٱ</tajweed>لْعِهْنِ <tajweed class=ham_wasl>ٱ</tajweed>لْمَ<tajweed class=ikhafa>نف</tajweed><tajweed class=madda_permissible>ُو</tajweed>شِ <span class=end>٥</span>","en":"And the mountains will be like wool, fluffed up."},{"n":6,"ar":"فَأَمّا مَن ثَقُلَت مَوٰزينُهُ","tj":"فَأَ<tajweed class=ghunnah>مّ</tajweed>َا مَ<tajweed class=ikhafa>ن ث</tajweed>َقُلَتْ مَو<tajweed class=madda_normal>َٲ</tajweed>زِينُهُۥ <span class=end>٦</span>","en":"Then as for one whose scales are heavy [with good deeds],"},{"n":7,"ar":"فَهُوَ فى عيشَةٍ راضِيَةٍ","tj":"فَهُوَ فِى عِيشَ<tajweed class=idgham_wo_ghunnah>ةٍ ر</tajweed>َّاضِيَةٍ <span class=end>٧</span>","en":"He will be in a pleasant life."},{"n":8,"ar":"وَأَمّا مَن خَفَّت مَوٰزينُهُ","tj":"وَأَ<tajweed class=ghunnah>مّ</tajweed>َا مَنْ خَفَّتْ مَو<tajweed class=madda_normal>َٲ</tajweed>زِينُهُۥ <span class=end>٨</span>","en":"But as for one whose scales are light,"},{"n":9,"ar":"فَأُمُّهُ هاوِيَةٌ","tj":"فَأُ<tajweed class=ghunnah>مّ</tajweed>ُهُ<tajweed class=madda_normal>ۥ</tajweed> هَاوِيَةٌ <span class=end>٩</span>","en":"His refuge will be an abyss."},{"n":10,"ar":"وَما أَدرىٰكَ ما هِيَه","tj":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=qalaqah>دْ</tajweed>رَ<tajweed class=madda_normal>ٮٰ</tajweed>كَ مَا هِيَهْ <span class=end>١٠</span>","en":"And what can make you know what that is?"},{"n":11,"ar":"نارٌ حامِيَةٌ","tj":"نَارٌ حَامِيَةُۢ <span class=end>١١</span>","en":"It is a Fire, intensely hot."}]}