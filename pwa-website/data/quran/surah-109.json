{"number":109,"nameArabic":"الكافرون","nameSimple":"Al-Kafirun","nameEnglish":"The Disbelievers","revelationPlace":"makkah","ayahCount":6,"bismillahPre":true,"ayahs":[{"n":1,"ar":"قُل يٰأَيُّهَا الكٰفِرونَ","tj":"قُلْ يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١</span>","en":"Say, \"O disbelievers,"},{"n":2,"ar":"لا أَعبُدُ ما تَعبُدونَ","tj":"ل<tajweed class=madda_obligatory>َآ</tajweed> أَعْبُدُ مَا تَعْبُد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢</span>","en":"I do not worship what you worship."},{"n":3,"ar":"وَلا أَنتُم عٰبِدونَ ما أَعبُدُ","tj":"وَل<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>ُمْ عَ<tajweed class=madda_normal>ـٰ</tajweed>بِدُونَ م<tajweed class=madda_obligatory>َآ</tajweed> أَعْبُ<tajweed class=qalaqah>د</tajweed>ُ <span class=end>٣</span>","en":"Nor are you worshippers of what I worship."},{"n":4,"ar":"وَلا أَنا۠ عابِدٌ ما عَبَدتُم","tj":"وَل<tajweed class=madda_obligatory>َآ</tajweed> أَنَا۟ عَابِ<tajweed class=idgham_ghunnah>دٌ م</tajweed>َّا عَبَ<tajweed class=idgham_mutajanisayn>د</tajweed>تُّمْ <span class=end>٤</span>","en":"Nor will I be a worshipper of what you worship."},{"n":5,"ar":"وَلا أَنتُم عٰبِدونَ ما أَعبُدُ","tj":"وَل<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>ُمْ عَ<tajweed class=madda_normal>ـٰ</tajweed>بِدُونَ م<tajweed class=madda_obligatory>َآ</tajweed> أَعْبُ<tajweed class=qalaqah>د</tajweed>ُ <span class=end>٥</span>","en":"Nor will you be worshippers of what I worship."},{"n":6,"ar":"لَكُم دينُكُم وَلِىَ دينِ","tj":"لَكُمْ دِينُكُمْ وَلِىَ د<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٦</span>","en":"For you is your religion, and for me is my religion.\""}]}