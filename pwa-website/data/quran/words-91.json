{"number":91,"ayahs":[[["وَٱلشَّمْسِ","By the sun"],["وَضُحَىٰهَا","and its brightness"]],[["وَٱلْقَمَرِ","And the moon"],["إِذَا","when"],["تَلَىٰهَا","it follows it"]],[["وَٱلنَّهَارِ","And the day"],["إِذَا","when"],["جَلَّىٰهَا","it displays it"]],[["وَٱلَّيْلِ","And the night"],["إِذَا","when"],["يَغْشَىٰهَا","it covers it"]],[["وَٱلسَّمَآءِ","And the heaven"],["وَمَا","and (He) Who"],["بَنَىٰهَا","constructed it"]],[["وَٱلْأَرْضِ","And the earth"],["وَمَا","and by (He) Who"],["طَحَىٰهَا","spread it"]],[["وَنَفْسٍۢ","And (the) soul"],["وَمَا","and (He) Who"],["سَوَّىٰهَا","proportioned it"]],[["فَأَلْهَمَهَا","And He inspired it"],["فُجُورَهَا","(to distinguish) its wickedness"],["وَتَقْوَىٰهَا","and its righteousness"]],[["قَدْ","Indeed"],["أَفْلَحَ","he succeeds"],["مَن","who"],["زَكَّىٰهَا","purifies it"]],[["وَقَدْ","And indeed"],["خَابَ","he fails"],["مَن","who"],["دَسَّىٰهَا","buries it"]],[["كَذَّبَتْ","Denied"],["ثَمُودُ","Thamud"],["بِطَغْوَىٰهَآ","by their transgression"]],[["إِذِ","When"],["ٱنۢبَعَثَ","(was) sent forth"],["أَشْقَىٰهَا","(the) most wicked of them"]],[["فَقَالَ","But said"],["لَهُمْ","to them"],["رَسُولُ","(the) Messenger"],["ٱللَّهِ","(of) Allah"],["نَاقَةَ","(It is the) she-camel"],["ٱللَّهِ","(of) Allah"],["وَسُقْيَـٰهَا","and her drink"]],[["فَكَذَّبُوهُ","But they denied him"],["فَعَقَرُوهَا","and they hamstrung her"],["فَدَمْدَمَ","So destroyed"],["عَلَيْهِمْ","them"],["رَبُّهُم","their Lord"],["بِذَنۢبِهِمْ","for their sin"],["فَسَوَّىٰهَا","and leveled them"]],[["وَلَا","And not"],["يَخَافُ","He fears"],["عُقْبَـٰهَا","its consequences"]]]}