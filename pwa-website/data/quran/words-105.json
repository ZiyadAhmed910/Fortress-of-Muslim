{"number":105,"ayahs":[[["أَلَمْ","Have not"],["تَرَ","you seen"],["كَيْفَ","how"],["فَعَلَ","dealt"],["رَبُّكَ","your Lord"],["بِأَصْحَـٰبِ","with (the) Companions"],["ٱلْفِيلِ","(of the) Elephant"]],[["أَلَمْ","Did not"],["يَجْعَلْ","He make"],["كَيْدَهُمْ","their plan"],["فِى","go"],["تَضْلِيلٍۢ","astray"]],[["وَأَرْسَلَ","And He sent"],["عَلَيْهِمْ","against them"],["طَيْرًا","birds"],["أَبَابِيلَ","(in) flocks"]],[["تَرْمِيهِم","Striking them"],["بِحِجَارَةٍۢ","with stones"],["مِّن","of"],["سِجِّيلٍۢ","baked clay"]],[["فَجَعَلَهُمْ","Then He made them"],["كَعَصْفٍۢ","like straw"],["مَّأْكُولٍۭ","eaten up"]]]}