{"number":96,"nameArabic":"العلق","nameSimple":"Al-'Alaq","nameEnglish":"The Clot","revelationPlace":"makkah","ayahCount":19,"bismillahPre":true,"ayahs":[{"n":1,"ar":"اقرَأ بِاسمِ رَبِّكَ الَّذى خَلَقَ","tj":"ٱ<tajweed class=qalaqah>قْ</tajweed>رَأْ بِ<tajweed class=ham_wasl>ٱ</tajweed>سْمِ رَبِّكَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى خَلَ<tajweed class=qalaqah>ق</tajweed>َ <span class=end>١</span>","en":"Recite in the name of your Lord who created -"},{"n":2,"ar":"خَلَقَ الإِنسٰنَ مِن عَلَقٍ","tj":"خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ مِنْ عَلَ<tajweed class=qalaqah>ق</tajweed>ٍ <span class=end>٢</span>","en":"Created man from a clinging substance."},{"n":3,"ar":"اقرَأ وَرَبُّكَ الأَكرَمُ","tj":"ٱ<tajweed class=qalaqah>قْ</tajweed>رَأْ وَرَبُّكَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَكْرَمُ <span class=end>٣</span>","en":"Recite, and your Lord is the most Generous -"},{"n":4,"ar":"الَّذى عَلَّمَ بِالقَلَمِ","tj":"ٱلَّذِى عَلَّمَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْقَلَمِ <span class=end>٤</span>","en":"Who taught by the pen -"},{"n":5,"ar":"عَلَّمَ الإِنسٰنَ ما لَم يَعلَم","tj":"عَلَّمَ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ مَا لَمْ يَعْلَمْ <span class=end>٥</span>","en":"Taught man that which he knew not."},{"n":6,"ar":"كَلّا إِنَّ الإِنسٰنَ لَيَطغىٰ","tj":"كَلّ<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ لَيَ<tajweed class=qalaqah>طْ</tajweed>غَىٰٓ <span class=end>٦</span>","en":"No! [But] indeed, man transgresses"},{"n":7,"ar":"أَن رَءاهُ استَغنىٰ","tj":"أ<tajweed class=idgham_wo_ghunnah>َن ر</tajweed>َّءَاهُ <tajweed class=ham_wasl>ٱ</tajweed>سْتَغْنَىٰٓ <span class=end>٧</span>","en":"Because he sees himself self-sufficient."},{"n":8,"ar":"إِنَّ إِلىٰ رَبِّكَ الرُّجعىٰ","tj":"إِ<tajweed class=ghunnah>نّ</tajweed>َ إِلَىٰ رَبِّكَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رُّ<tajweed class=qalaqah>جْ</tajweed>عَىٰٓ <span class=end>٨</span>","en":"Indeed, to your Lord is the return."},{"n":9,"ar":"أَرَءَيتَ الَّذى يَنهىٰ","tj":"أَرَءَيْتَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يَنْهَىٰ <span class=end>٩</span>","en":"Have you seen the one who forbids"},{"n":10,"ar":"عَبدًا إِذا صَلّىٰ","tj":"عَ<tajweed class=qalaqah>بْ</tajweed>دًا إِذَا صَلَّىٰٓ <span class=end>١٠</span>","en":"A servant when he prays?"},{"n":11,"ar":"أَرَءَيتَ إِن كانَ عَلَى الهُدىٰ","tj":"أَرَءَيْتَ إِ<tajweed class=ikhafa>ن ك</tajweed>َانَ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْهُدَىٰٓ <span class=end>١١</span>","en":"Have you seen if he is upon guidance"},{"n":12,"ar":"أَو أَمَرَ بِالتَّقوىٰ","tj":"أَوْ أَمَرَ بِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>تَّ<tajweed class=qalaqah>قْ</tajweed>وَىٰٓ <span class=end>١٢</span>","en":"Or enjoins righteousness?"},{"n":13,"ar":"أَرَءَيتَ إِن كَذَّبَ وَتَوَلّىٰ","tj":"أَرَءَيْتَ إِ<tajweed class=ikhafa>ن ك</tajweed>َذَّبَ وَتَوَلَّىٰٓ <span class=end>١٣</span>","en":"Have you seen if he denies and turns away -"},{"n":14,"ar":"أَلَم يَعلَم بِأَنَّ اللَّهَ يَرىٰ","tj":"أَلَمْ يَعْل<tajweed class=ikhafa_shafawi>َم ب</tajweed>ِأَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ يَرَىٰ <span class=end>١٤</span>","en":"Does he not know that Allah sees?"},{"n":15,"ar":"كَلّا لَئِن لَم يَنتَهِ لَنَسفَعًا بِالنّاصِيَةِ","tj":"كَلَّا لَئ<tajweed class=idgham_wo_ghunnah>ِن ل</tajweed>َّمْ يَ<tajweed class=ikhafa>نت</tajweed>َهِ لَنَسْفَع<tajweed class=iqlab>َۢا ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاصِيَةِ <span class=end>١٥</span>","en":"No! If he does not desist, We will surely drag him by the forelock -"},{"n":16,"ar":"ناصِيَةٍ كٰذِبَةٍ خاطِئَةٍ","tj":"نَاصِيَ<tajweed class=ikhafa>ةٍ ك</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>ذِبَةٍ خَاطِئَةٍ <span class=end>١٦</span>","en":"A lying, sinning forelock."},{"n":17,"ar":"فَليَدعُ نادِيَهُ","tj":"فَلْيَ<tajweed class=qalaqah>دْ</tajweed>عُ نَادِيَهُۥ <span class=end>١٧</span>","en":"Then let him call his associates;"},{"n":18,"ar":"سَنَدعُ الزَّبانِيَةَ","tj":"سَنَ<tajweed class=qalaqah>دْ</tajweed>عُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>زَّبَانِيَةَ <span class=end>١٨</span>","en":"We will call the angels of Hell."},{"n":19,"ar":"كَلّا لا تُطِعهُ وَاسجُد وَاقتَرِب","tj":"كَلَّا لَا تُطِعْهُ وَ<tajweed class=ham_wasl>ٱ</tajweed>سْجُ<tajweed class=qalaqah>دْ</tajweed> وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>قْ</tajweed>تَرِ<tajweed class=qalaqah>ب</tajweed> ۩ <span class=end>١٩</span>","en":"No! Do not obey him. But prostrate and draw near [to Allah].","sajdah":14}]}