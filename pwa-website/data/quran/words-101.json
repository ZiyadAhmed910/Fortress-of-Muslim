{"number":101,"ayahs":[[["ٱلْقَارِعَةُ","The Striking Calamity"]],[["مَا","What"],["ٱلْقَارِعَةُ","(is) the Striking Calamity"]],[["وَمَآ","And what"],["أَدْرَىٰكَ","will make you know"],["مَا","what"],["ٱلْقَارِعَةُ","(is) the Striking Calamity"]],[["يَوْمَ","(The) Day"],["يَكُونُ","will be"],["ٱلنَّاسُ","the mankind"],["كَٱلْفَرَاشِ","like moths"],["ٱلْمَبْثُوثِ","scattered"]],[["وَتَكُونُ","And will be"],["ٱلْجِبَالُ","the mountains"],["كَٱلْعِهْنِ","like wool"],["ٱلْمَنفُوشِ","fluffed up"]],[["فَأَمَّا","Then as for"],["مَن","(him) whose"],["ثَقُلَتْ","(are) heavy"],["مَوَٰزِينُهُۥ","his scales"]],[["فَهُوَ","Then he"],["فِى","(will be) in"],["عِيشَةٍۢ","a life"],["رَّاضِيَةٍۢ","pleasant"]],[["وَأَمَّا","But as for"],["مَنْ","(him) whose"],["خَفَّتْ","(are) light"],["مَوَٰزِينُهُۥ","his scales"]],[["فَأُمُّهُۥ","His abode"],["هَاوِيَةٌۭ","(will be the) Pit"]],[["وَمَآ","And what"],["أَدْرَىٰكَ","will make you know"],["مَا","what"],["هِيَهْ","it is"]],[["نَارٌ","A Fire"],["حَامِيَةٌۢ","intensely hot"]]]}