{"number":107,"nameArabic":"الماعون","nameSimple":"Al-Ma'un","nameEnglish":"The Small kindnesses","revelationPlace":"makkah","ayahCount":7,"bismillahPre":true,"ayahs":[{"n":1,"ar":"أَرَءَيتَ الَّذى يُكَذِّبُ بِالدّينِ","tj":"أَرَءَيْتَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يُكَذِّبُ بِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دّ<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>١</span>","en":"Have you seen the one who denies the Recompense?"},{"n":2,"ar":"فَذٰلِكَ الَّذى يَدُعُّ اليَتيمَ","tj":"فَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يَدُعُّ <tajweed class=ham_wasl>ٱ</tajweed>لْيَت<tajweed class=madda_permissible>ِي</tajweed>مَ <span class=end>٢</span>","en":"For that is the one who drives away the orphan"},{"n":3,"ar":"وَلا يَحُضُّ عَلىٰ طَعامِ المِسكينِ","tj":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ <tajweed class=ham_wasl>ٱ</tajweed>لْمِسْك<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٣</span>","en":"And does not encourage the feeding of the poor."},{"n":4,"ar":"فَوَيلٌ لِلمُصَلّينَ","tj":"فَوَيْ<tajweed class=idgham_wo_ghunnah>لٌ ل</tajweed>ِّلْمُصَلّ<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤</span>","en":"So woe to those who pray"},{"n":5,"ar":"الَّذينَ هُم عَن صَلاتِهِم ساهونَ","tj":"ٱلَّذِينَ هُمْ عَ<tajweed class=ikhafa>ن ص</tajweed>َلَاتِهِمْ سَاه<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥</span>","en":"[But] who are heedless of their prayer -"},{"n":6,"ar":"الَّذينَ هُم يُراءونَ","tj":"ٱلَّذِينَ هُمْ يُر<tajweed class=madda_obligatory>َا</tajweed>ٓء<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦</span>","en":"Those who make show [of their deeds]"},{"n":7,"ar":"وَيَمنَعونَ الماعونَ","tj":"وَيَمْنَعُونَ <tajweed class=ham_wasl>ٱ</tajweed>لْمَاع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧</span>","en":"And withhold [simple] assistance."}]}