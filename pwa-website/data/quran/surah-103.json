{"number":103,"nameArabic":"العصر","nameSimple":"Al-'Asr","nameEnglish":"The Declining Day","revelationPlace":"makkah","ayahCount":3,"bismillahPre":true,"ayahs":[{"n":1,"ar":"وَالعَصرِ","tj":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْعَصْرِ <span class=end>١</span>","en":"By time,"},{"n":2,"ar":"إِنَّ الإِنسٰنَ لَفى خُسرٍ","tj":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ لَفِى خُسْرٍ <span class=end>٢</span>","en":"Indeed, mankind is in loss,"},{"n":3,"ar":"إِلَّا الَّذينَ ءامَنوا وَعَمِلُوا الصّٰلِحٰتِ وَتَواصَوا بِالحَقِّ وَتَواصَوا بِالصَّبرِ","tj":"إِلَّا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> وَعَمِلُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِحَ<tajweed class=madda_normal>ـٰ</tajweed>تِ وَتَوَاصَوْ<tajweed class=slnt>اْ</tajweed> بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ وَتَوَاصَوْ<tajweed class=slnt>اْ</tajweed> بِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=qalaqah>بْ</tajweed>رِ <span class=end>٣</span>","en":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience."}]}