{"number":107,"ayahs":[[["أَرَءَيْتَ","Have you seen"],["ٱلَّذِى","the one who"],["يُكَذِّبُ","denies"],["بِٱلدِّينِ","the Judgment"]],[["فَذَٰلِكَ","Then that"],["ٱلَّذِى","(is) the one who"],["يَدُعُّ","repulses"],["ٱلْيَتِيمَ","the orphan"]],[["وَلَا","And (does) not"],["يَحُضُّ","feel the urge"],["عَلَىٰ","to"],["طَعَامِ","feed"],["ٱلْمِسْكِينِ","the poor"]],[["فَوَيْلٌۭ","So woe"],["لِّلْمُصَلِّينَ","to those who pray"]],[["ٱلَّذِينَ","Those who"],["هُمْ","[they]"],["عَن","about"],["صَلَاتِهِمْ","their prayers"],["سَاهُونَ","(are) neglectful"]],[["ٱلَّذِينَ","Those who"],["هُمْ","[they]"],["يُرَآءُونَ","make show"]],[["وَيَمْنَعُونَ","And they deny"],["ٱلْمَاعُونَ","[the] small kindnesses"]]]}