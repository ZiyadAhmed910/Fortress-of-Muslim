{"number":104,"ayahs":[[["وَيْلٌۭ","Woe"],["لِّكُلِّ","to every"],["هُمَزَةٍۢ","slanderer"],["لُّمَزَةٍ","backbiter"]],[["ٱلَّذِى","The one who"],["جَمَعَ","collects"],["مَالًۭا","wealth"],["وَعَدَّدَهُۥ","and counts it"]],[["يَحْسَبُ","Thinking"],["أَنَّ","that"],["مَالَهُۥٓ","his wealth"],["أَخْلَدَهُۥ","will make him immortal"]],[["كَلَّا ۖ","Nay"],["لَيُنۢبَذَنَّ","Surely he will be thrown"],["فِى","in"],["ٱلْحُطَمَةِ","the Crusher"]],[["وَمَآ","And what"],["أَدْرَىٰكَ","will make you know"],["مَا","what"],["ٱلْحُطَمَةُ","the Crusher (is)"]],[["نَارُ","A Fire"],["ٱللَّهِ","Allah"],["ٱلْمُوقَدَةُ","kindled"]],[["ٱلَّتِى","Which"],["تَطَّلِعُ","mounts up"],["عَلَى","to"],["ٱلْأَفْـِٔدَةِ","the hearts"]],[["إِنَّهَا","Indeed, it"],["عَلَيْهِم","(will be) upon them"],["مُّؤْصَدَةٌۭ","closed over"]],[["فِى","In"],["عَمَدٍۢ","columns"],["مُّمَدَّدَةٍۭ","extended"]]]}