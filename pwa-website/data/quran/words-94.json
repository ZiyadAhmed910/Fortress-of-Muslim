{"number":94,"ayahs":[[["أَلَمْ","Have not"],["نَشْرَحْ","We expanded"],["لَكَ","for you"],["صَدْرَكَ","your breast"]],[["وَوَضَعْنَا","And We removed"],["عَنكَ","from you"],["وِزْرَكَ","your burden"]],[["ٱلَّذِىٓ","Which"],["أَنقَضَ","weighed upon"],["ظَهْرَكَ","your back"]],[["وَرَفَعْنَا","And We raised high"],["لَكَ","for you"],["ذِكْرَكَ","your reputation"]],[["فَإِنَّ","So indeed"],["مَعَ","with"],["ٱلْعُسْرِ","the hardship"],["يُسْرًا","(is) ease"]],[["إِنَّ","Indeed"],["مَعَ","with"],["ٱلْعُسْرِ","the hardship"],["يُسْرًۭا","(is) ease"]],[["فَإِذَا","So when"],["فَرَغْتَ","you have finished"],["فَٱنصَبْ","then labor hard"]],[["وَإِلَىٰ","And to"],["رَبِّكَ","your Lord"],["فَٱرْغَب","turn your attention"]]]}