{"number":110,"ayahs":[[["إِذَا","When"],["جَآءَ","comes"],["نَصْرُ","(the) Help"],["ٱللَّهِ","(of) Allah"],["وَٱلْفَتْحُ","and the Victory"]],[["وَرَأَيْتَ","And you see"],["ٱلنَّاسَ","the people"],["يَدْخُلُونَ","entering"],["فِى","into"],["دِينِ","(the) religion"],["ٱللَّهِ","(of) Allah"],["أَفْوَاجًۭا","(in) multitudes"]],[["فَسَبِّحْ","Then glorify"],["بِحَمْدِ","with (the) praises"],["رَبِّكَ","(of) your Lord"],["وَٱسْتَغْفِرْهُ ۚ","and ask His forgiveness"],["إِنَّهُۥ","Indeed, He"],["كَانَ","is"],["تَوَّابًۢا","Oft-Returning"]]]}