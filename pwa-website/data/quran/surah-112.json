{"number":112,"nameArabic":"الإخلاص","nameSimple":"Al-Ikhlas","nameEnglish":"The Sincerity","revelationPlace":"makkah","ayahCount":4,"bismillahPre":true,"ayahs":[{"n":1,"ar":"قُل هُوَ اللَّهُ أَحَدٌ","en":"Say, \"He is Allah, [who is] One,"},{"n":2,"ar":"اللَّهُ الصَّمَدُ","en":"Allah, the Eternal Refuge."},{"n":3,"ar":"لَم يَلِد وَلَم يولَد","en":"He neither begets nor is born,"},{"n":4,"ar":"وَلَم يَكُن لَهُ كُفُوًا أَحَدٌ","en":"Nor is there to Him any equivalent.\""}]}