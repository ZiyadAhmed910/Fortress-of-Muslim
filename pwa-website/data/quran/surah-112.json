{"number":112,"nameArabic":"الإخلاص","nameSimple":"Al-Ikhlas","nameEnglish":"The Sincerity","revelationPlace":"makkah","ayahCount":4,"bismillahPre":true,"ayahs":[{"n":1,"ar":"قُل هُوَ اللَّهُ أَحَدٌ","tj":"قُلْ هُوَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ أَحَ<tajweed class=qalaqah>د</tajweed>ٌ <span class=end>١</span>","en":"Say, \"He is Allah, [who is] One,"},{"n":2,"ar":"اللَّهُ الصَّمَدُ","tj":"ٱللَّهُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّمَ<tajweed class=qalaqah>د</tajweed>ُ <span class=end>٢</span>","en":"Allah, the Eternal Refuge."},{"n":3,"ar":"لَم يَلِد وَلَم يولَد","tj":"لَمْ يَلِ<tajweed class=qalaqah>دْ</tajweed> وَلَمْ يُولَ<tajweed class=qalaqah>دْ</tajweed> <span class=end>٣</span>","en":"He neither begets nor is born,"},{"n":4,"ar":"وَلَم يَكُن لَهُ كُفُوًا أَحَدٌ","tj":"وَلَمْ يَك<tajweed class=idgham_wo_ghunnah>ُن ل</tajweed>َّهُ<tajweed class=madda_normal>ۥ</tajweed> كُفُوًا أَحَ<tajweed class=qalaqah>د</tajweed>ُۢ <span class=end>٤</span>","en":"Nor is there to Him any equivalent.\""}]}