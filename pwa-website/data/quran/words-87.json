{"number":87,"ayahs":[[["سَبِّحِ","Glorify"],["ٱسْمَ","(the) name"],["رَبِّكَ","(of) your Lord"],["ٱلْأَعْلَى","the Most High"]],[["ٱلَّذِى","The One Who"],["خَلَقَ","created"],["فَسَوَّىٰ","then proportioned"]],[["وَٱلَّذِى","And the One Who"],["قَدَّرَ","measured"],["فَهَدَىٰ","then guided"]],[["وَٱلَّذِىٓ","And the One Who"],["أَخْرَجَ","brings forth"],["ٱلْمَرْعَىٰ","the pasture"]],[["فَجَعَلَهُۥ","And then makes it"],["غُثَآءً","stubble"],["أَحْوَىٰ","dark"]],[["سَنُقْرِئُكَ","We will make you recite"],["فَلَا","so not"],["تَنسَىٰٓ","you will forget"]],[["إِلَّا","Except"],["مَا","what"],["شَآءَ","wills"],["ٱللَّهُ ۚ","Allah"],["إِنَّهُۥ","Indeed, He"],["يَعْلَمُ","knows"],["ٱلْجَهْرَ","the manifest"],["وَمَا","and what"],["يَخْفَىٰ","is hidden"]],[["وَنُيَسِّرُكَ","And We will ease you"],["لِلْيُسْرَىٰ","to the ease"]],[["فَذَكِّرْ","So remind"],["إِن","if"],["نَّفَعَتِ","benefits"],["ٱلذِّكْرَىٰ","the reminder"]],[["سَيَذَّكَّرُ","He will pay heed "],["مَن","(one) who"],["يَخْشَىٰ","fears (Allah)"]],[["وَيَتَجَنَّبُهَا","And will avoid it"],["ٱلْأَشْقَى","the wretched one"]],[["ٱلَّذِى","The one who"],["يَصْلَى","will burn"],["ٱلنَّارَ","(in) the Fire"],["ٱلْكُبْرَىٰ","[the] great"]],[["ثُمَّ","Then"],["لَا","not"],["يَمُوتُ","he will die"],["فِيهَا","therein"],["وَلَا","and not"],["يَحْيَىٰ","will live"]],[["قَدْ","Certainly"],["أَفْلَحَ","has succeeded"],["مَن","(one) who"],["تَزَكَّىٰ","purifies (himself)"]],[["وَذَكَرَ","And remembers"],["ٱسْمَ","(the) name"],["رَبِّهِۦ","(of) his Lord"],["فَصَلَّىٰ","and prays"]],[["بَلْ","Nay"],["تُؤْثِرُونَ","You prefer"],["ٱلْحَيَوٰةَ","the life"],["ٱلدُّنْيَا","(of) the world"]],[["وَٱلْـَٔاخِرَةُ","While the Hereafter"],["خَيْرٌۭ","(is) better"],["وَأَبْقَىٰٓ","and everlasting"]],[["إِنَّ","Indeed"],["هَـٰذَا","this"],["لَفِى","surely (is) in"],["ٱلصُّحُفِ","the Scriptures"],["ٱلْأُولَىٰ","[the] former"]],[["صُحُفِ","(The) Scriptures"],["إِبْرَٰهِيمَ","(of) Ibrahim"],["وَمُوسَىٰ","and Musa"]]]}