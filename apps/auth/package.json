{
  "name": "@fortress/auth",
  "version": "0.19.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env test",
    "deploy:test": "wrangler deploy --env test",
    "deploy:production": "wrangler deploy --env production",
    "deploy:test:ci": "wrangler deploy --config wrangler.ci.jsonc --env test",
    "deploy:production:ci": "wrangler deploy --config wrangler.ci.jsonc --env production",
    "db:migrate:test": "wrangler d1 migrations apply fortress-identity-test --remote --env test",
    "db:migrate:production": "wrangler d1 migrations apply fortress-identity-production --remote --env production",
    "typecheck": "tsc --noEmit",
    "test": "node tools/verify-schema.mjs && vitest run"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.0-rc.1",
    "@better-auth/core": "1.7.0-rc.1",
    "@better-auth/kysely-adapter": "1.7.0-rc.1",
    "@better-auth/oauth-provider": "1.7.0-rc.1",
    "@better-auth/passkey": "1.7.0-rc.1",
    "@fortress/contracts": "0.19.1",
    "better-auth": "1.7.0-rc.1",
    "hono": "^4.8.0",
    "kysely": "0.28.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250711.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "better-sqlite3": "^12.4.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.24.0"
  }
}
