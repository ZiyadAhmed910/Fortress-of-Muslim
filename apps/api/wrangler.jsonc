{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fortress-platform-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "env": {
    "test": {
      "name": "fortress-platform-api-test",
      "triggers": {
        "crons": ["* * * * *"]
      },
      "ai": {
        "binding": "AI"
      },
      "routes": [
        {
          "pattern": "api-test.fortressofmuslim.org",
          "custom_domain": true
        }
      ],
      "vars": {
        "PLATFORM_ENV": "test"
      },
      "d1_databases": [
        {
          "binding": "CONTENT_DB",
          "database_name": "fortress-platform-test",
          "database_id": "a5f4b33f-5c6e-4a0c-b506-3e04d263ffb7",
          "migrations_dir": "migrations"
        }
      ],
      "vectorize": [
        {
          "binding": "VECTOR_INDEX",
          "index_name": "fortress-rag-test"
        }
      ],
      "services": [
        {
          "binding": "AUTH",
          "service": "fortress-platform-auth-test"
        }
      ]
    },
    "production": {
      "name": "fortress-platform-api-production",
      "triggers": {
        "crons": ["* * * * *"]
      },
      "ai": {
        "binding": "AI"
      },
      "routes": [
        {
          "pattern": "api.fortressofmuslim.org",
          "custom_domain": true
        }
      ],
      "vars": {
        "PLATFORM_ENV": "production"
      },
      "d1_databases": [
        {
          "binding": "CONTENT_DB",
          "database_name": "fortress-platform-production",
          "database_id": "36233189-9e08-47de-b862-1530dcda24a3",
          "migrations_dir": "migrations"
        }
      ],
      "vectorize": [
        {
          "binding": "VECTOR_INDEX",
          "index_name": "fortress-rag-production"
        }
      ],
      "services": [
        {
          "binding": "AUTH",
          "service": "fortress-platform-auth-production"
        }
      ]
    }
  }
}
