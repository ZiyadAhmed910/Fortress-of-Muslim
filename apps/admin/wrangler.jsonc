{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fortress-admin",
  "compatibility_date": "2026-07-18",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "env": {
    "test": { "name": "fortress-admin-test", "routes": [{ "pattern": "admin-test.fortressofmuslim.org", "custom_domain": true }] },
    "production": { "name": "fortress-admin-production", "routes": [{ "pattern": "admin.fortressofmuslim.org", "custom_domain": true }] }
  }
}
