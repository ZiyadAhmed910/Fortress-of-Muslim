{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fortress-status",
  "compatibility_date": "2026-07-18",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "env": {
    "test": {
      "name": "fortress-status-test",
      "routes": [{ "pattern": "status-test.fortressofmuslim.org", "custom_domain": true }]
    },
    "production": {
      "name": "fortress-status-production",
      "routes": [{ "pattern": "status.fortressofmuslim.org", "custom_domain": true }]
    }
  }
}
