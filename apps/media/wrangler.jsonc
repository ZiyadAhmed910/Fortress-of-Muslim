{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fortress-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "observability": { "enabled": true },
  "env": {
    // One bucket for both environments: the files are identical, and a second copy would double the
    // storage bill for nothing. The counts are what differ, and those go to each environment's own D1
    // -- so a play on test never reaches a report built from production.
    "test": {
      "name": "fortress-media-test",
      "routes": [{ "pattern": "media-test.fortressofmuslim.org", "custom_domain": true }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "fortress-media" }],
      "d1_databases": [{
        "binding": "CONTENT_DB",
        "database_name": "fortress-platform-test",
        "database_id": "a5f4b33f-5c6e-4a0c-b506-3e04d263ffb7"
      }]
    },
    "production": {
      "name": "fortress-media-production",
      "routes": [{ "pattern": "media.fortressofmuslim.org", "custom_domain": true }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "fortress-media" }],
      "d1_databases": [{
        "binding": "CONTENT_DB",
        "database_name": "fortress-platform-production",
        "database_id": "36233189-9e08-47de-b862-1530dcda24a3"
      }]
    }
  }
}
