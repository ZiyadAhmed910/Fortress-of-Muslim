{
  "name": "@fortress/media",
  "version": "0.48.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:test": "wrangler deploy --env test",
